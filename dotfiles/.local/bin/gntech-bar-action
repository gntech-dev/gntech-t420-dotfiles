#!/usr/bin/env bash

set -u

ACTION="${1:-}"

terminal() {
    alacritty -e "$@" &
}

case "$ACTION" in

    cpu|temperature|memory)
        terminal btop
        ;;

    disk)
        thunar / &
        ;;

    wifi)
        terminal nmtui
        ;;

    volume-toggle)
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        ;;

    volume-up)
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        ;;

    volume-down)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
        ;;

    battery)
        terminal "$HOME/.local/bin/gntech-battery-info"
        ;;

    calendar)
        terminal calcurse
        ;;

    *)
        echo "Unknown action: $ACTION" >&2
        exit 1
        ;;
esac

#!/usr/bin/env bash

BAT="/sys/class/power_supply/BAT0"

read_value() {
    if [[ -r "$BAT/$1" ]]; then
        cat "$BAT/$1"
    else
        echo "N/A"
    fi
}

wh_value() {
    local value
    value=$(read_value "$1")

    if [[ "$value" =~ ^[0-9]+$ ]]; then
        awk -v n="$value" 'BEGIN {printf "%.2f Wh", n/1000000}'
    else
        echo "N/A"
    fi
}

clear

fastfetch --logo arch --structure OS:Kernel:Uptime 2>/dev/null || true

printf '\n'
printf '\033[1;36m'
printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
printf '       ARCH LINUX // T420 BATTERY\n'
printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
printf '\033[0m\n'

capacity=$(read_value capacity)
status=$(read_value status)

if [[ "$capacity" =~ ^[0-9]+$ ]]; then
    if (( capacity <= 15 )); then
        color='\033[1;31m'
    elif (( capacity <= 40 )); then
        color='\033[1;33m'
    else
        color='\033[1;32m'
    fi
else
    color='\033[0m'
fi

printf '  Charge:          '
printf '%b%s%%%b\n' "$color" "$capacity" '\033[0m'
printf '  Status:          %s\n' "$status"

printf '  Current energy:  %s\n' "$(wh_value energy_now)"
printf '  Full capacity:   %s\n' "$(wh_value energy_full)"
printf '  Design capacity: %s\n' "$(wh_value energy_full_design)"

full=$(read_value energy_full)
design=$(read_value energy_full_design)

if [[ "$full" =~ ^[0-9]+$ &&
      "$design" =~ ^[0-9]+$ ]] && (( design > 0 )); then
    awk -v f="$full" -v d="$design" \
        'BEGIN {printf "  Battery health:  %.1f%%\n", f/d*100}'
fi

printf '\n'
printf '  Start charging:  %s%%\n' \
    "$(read_value charge_control_start_threshold)"
printf '  Stop charging:   %s%%\n' \
    "$(read_value charge_control_end_threshold)"

power=$(read_value power_now)

if [[ "$power" =~ ^[0-9]+$ ]]; then
    awk -v p="$power" \
        'BEGIN {printf "  Battery power:   %.2f W\n", p/1000000}'
fi

printf '\n'
printf '\033[1;36m'
printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
printf '\033[0m\n'

read -rp "  Press Enter to close..."

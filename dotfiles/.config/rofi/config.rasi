configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Applications";
    font: "JetBrainsMono Nerd Font 11";
    drun-display-format: "{name}";
}

* {
    bg: #10141c;
    bg-alt: #1b2636;
    fg: #d6deeb;
    accent: #00d9ff;
    selected: #253449;
}

window {
    width: 550px;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    background-color: @bg;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 10px;
    background-color: @bg-alt;
    border-radius: 6px;
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: #748399;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 5px;
    background-color: @bg;
}

element {
    padding: 8px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 5px;
}

element selected {
    background-color: @selected;
    text-color: @accent;
}

element-icon {
    size: 22px;
}

element-text {
    text-color: inherit;
}
